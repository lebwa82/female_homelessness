[Unit]
Description=Scoped Chatwoot metadata DDS hourly load
After=network-online.target

[Service]
Type=oneshot
User=nevidimy-analytics
WorkingDirectory=/opt/nevidimy/analytics/current
EnvironmentFile=/etc/nevidimy/dds.env
ExecStart=/opt/nevidimy/analytics/venv/bin/python -m analytics.dds --config /etc/nevidimy/dds.json load --apply
TimeoutStartSec=300
MemoryMax=128M
CPUQuota=50%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
