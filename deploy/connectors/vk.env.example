# Copy to /etc/women-help-vk.env, chmod 600. No Telegram/LLM/DB credentials.
CONNECTOR_ENV_FILE=/etc/women-help-vk.env
CONNECTOR_IMAGE=localhost/women-help-vk:CHANGE_ME
CONNECTOR_BIND_PORT=8091
CONNECTOR_PROVIDER=vk
CONNECTOR_CHATWOOT_URL=https://chatwoot.example.org
CONNECTOR_ACCOUNT_ID=1
CONNECTOR_INBOX_ID=0
CONNECTOR_API_TOKEN=
CONNECTOR_INBOX_IDENTIFIER=
CONNECTOR_INBOX_HMAC_TOKEN=
CONNECTOR_CALLBACK_SECRET=
CONNECTOR_VK_GROUP_ID=0
CONNECTOR_VK_TOKEN=
CONNECTOR_VK_SECRET=
CONNECTOR_VK_CONFIRMATION=
CONNECTOR_VK_API_VERSION=5.199
# Extra exact hosts for private Chatwoot attachment redirects (e.g. S3).
CONNECTOR_ATTACHMENT_HOSTS=
