# Copy to /etc/women-help-whatsapp.env, chmod 600. Separate credentials from VK.
CONNECTOR_ENV_FILE=/etc/women-help-whatsapp.env
CONNECTOR_IMAGE=localhost/women-help-whatsapp:CHANGE_ME
CONNECTOR_BIND_PORT=8092
CONNECTOR_PROVIDER=whatsapp
CONNECTOR_CHATWOOT_URL=https://chatwoot.example.org
CONNECTOR_ACCOUNT_ID=1
CONNECTOR_INBOX_ID=0
CONNECTOR_API_TOKEN=
CONNECTOR_INBOX_IDENTIFIER=
CONNECTOR_INBOX_HMAC_TOKEN=
CONNECTOR_CALLBACK_SECRET=
CONNECTOR_WHATSAPP_PHONE_ID=
CONNECTOR_WHATSAPP_BUSINESS_ID=
CONNECTOR_WHATSAPP_TOKEN=
CONNECTOR_WHATSAPP_APP_SECRET=
CONNECTOR_WHATSAPP_VERIFY_TOKEN=
# Set the Graph API version supported by your Meta app, e.g. v25.0.
CONNECTOR_WHATSAPP_API_VERSION=
CONNECTOR_ATTACHMENT_HOSTS=
