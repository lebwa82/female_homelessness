[Unit]
Description=Women Help PostgreSQL container
Wants=network-online.target
After=network-online.target podman.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/women-help-bot
EnvironmentFile=/etc/women-help-bot.env
ExecStart=/usr/bin/podman-compose up -d postgres
ExecStop=/usr/bin/podman-compose stop postgres

[Install]
WantedBy=multi-user.target
