[Unit]
Description=Telegram long polling through proxy into native Chatwoot inbox
Requires=women-help-chatwoot.service
After=women-help-chatwoot.service women-help-chatwoot-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/women-help-chatwoot.env
WorkingDirectory=/opt/women-help-chatwoot
ExecStart=/usr/bin/podman compose --env-file /etc/women-help-chatwoot.env -f deploy/chatwoot/compose.yml up -d --force-recreate --no-deps telegram-ingress
ExecStop=/usr/bin/podman compose --env-file /etc/women-help-chatwoot.env -f deploy/chatwoot/compose.yml stop telegram-ingress
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
