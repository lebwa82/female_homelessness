[Unit]
Description=Women Help Chatwoot Agent Bot
Requires=women-help-chatwoot.service
After=women-help-chatwoot.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/women-help-chatwoot.env
EnvironmentFile=/etc/women-help-agent.env
WorkingDirectory=/opt/women-help-chatwoot/current
ExecStart=/usr/bin/podman compose --env-file /etc/women-help-chatwoot.env -f deploy/chatwoot/compose.yml --profile agent up -d agent-bot
ExecStop=/usr/bin/podman compose --env-file /etc/women-help-chatwoot.env -f deploy/chatwoot/compose.yml --profile agent stop agent-bot
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
