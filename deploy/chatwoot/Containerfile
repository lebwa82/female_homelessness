FROM ghcr.io/astral-sh/uv:0.12.7 AS uv

FROM docker.io/library/python:3.14.7-slim

COPY --from=uv /uv /uvx /bin/
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY app ./app
COPY scripts/__init__.py scripts/import_certificates.py scripts/import_chatwoot_certificates.py ./scripts/
COPY deploy ./deploy
COPY knowledge ./knowledge
COPY skills ./skills
ARG RELEASE_REVISION=dev
ARG RELEASED_AT_UTC
RUN python -c 'import json,os; from pathlib import Path; Path(".release.json").write_text(json.dumps({"revision":os.environ["RELEASE_REVISION"],"released_at_utc":os.environ.get("RELEASED_AT_UTC","")}))'

CMD ["/app/.venv/bin/python", "-m", "app.chatwoot"]
