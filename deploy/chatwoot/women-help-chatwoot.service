[Unit]
Description=Women Help Chatwoot test stack
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/women-help-chatwoot.env
WorkingDirectory=/opt/women-help-chatwoot
ExecStart=/usr/bin/podman compose --env-file /etc/women-help-chatwoot.env -f deploy/chatwoot/compose.yml up -d postgres redis chatwoot sidekiq caddy
ExecStop=/usr/bin/podman compose --env-file /etc/women-help-chatwoot.env -f deploy/chatwoot/compose.yml down
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
