{$CHATWOOT_HOSTNAME} {
    encode zstd gzip
    reverse_proxy https://chatwoot:3000 {
        transport http {
            tls_trust_pool file /run/tls/ca.crt
        }
    }
}

{$AGENT_HOSTNAME} {
    reverse_proxy https://agent-bot:8080 {
        transport http {
            tls_trust_pool file /run/tls/ca.crt
        }
    }
}
