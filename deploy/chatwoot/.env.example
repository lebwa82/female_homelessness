# Test-contour public names. For a VM with no DNS zone, use sslip.io, for example
# chatwoot.51-250-26-31.sslip.io and agent.51-250-26-31.sslip.io.
CHATWOOT_HOSTNAME=chatwoot.example.test
AGENT_HOSTNAME=agent.example.test

# Create one administrator through the dashboard, then change this to false.
ENABLE_ACCOUNT_SIGNUP=true

# Generate distinct high-entropy values; never commit the resulting .env file.
POSTGRES_PASSWORD=replace-with-random-password
SECRET_KEY_BASE=replace-with-random-alphanumeric-secret
CHATWOOT_WEBHOOK_SECRET=replace-with-43-character-url-safe-secret
# Leave blank for Chatwoot v4.12.1. Set the separately issued signing secret
# only after moving to a release that supports signed Agent Bot webhooks.
CHATWOOT_WEBHOOK_HMAC_SECRET=

# /etc/women-help-agent.env is separate and contains only the Agent Bot runtime:
# APP_ENV=test
# BUILD_VERSION=git-revision
# YANDEX_AI_API_KEY=...
# CHATWOOT_BASE_URL=https://chatwoot.example.test
# CHATWOOT_ACCOUNT_ID=...
# CHATWOOT_READ_TOKEN=...
# CHATWOOT_BOT_TOKEN=...
# CHATWOOT_DUTY_TEAM_ID=...
