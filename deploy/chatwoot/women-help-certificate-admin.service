[Unit]
Description=Women Help Certificate Administration Bot
Requires=women-help-chatwoot.service
After=women-help-chatwoot.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/women-help-chatwoot.env
EnvironmentFile=/etc/women-help-agent.env
WorkingDirectory=/opt/women-help-chatwoot
ExecStart=/usr/bin/podman compose --env-file /etc/women-help-chatwoot.env -f deploy/chatwoot/compose.yml up -d certificate-admin-bot
ExecStop=/usr/bin/podman compose --env-file /etc/women-help-chatwoot.env -f deploy/chatwoot/compose.yml stop certificate-admin-bot
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
