[Unit]
Description=Nevidimy Chatwoot core on Timeweb
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nevidimy/app
ExecStartPre=/usr/bin/grep -Fxq timeweb-nevidimy-prod-app-msk-1 /etc/nevidimy-deployment-target
ExecStart=/usr/bin/python3 scripts/chatwoot_compose.py up -d --no-build --pull never --wait --wait-timeout 240 redis chatwoot sidekiq caddy
ExecStop=/usr/bin/python3 scripts/chatwoot_compose.py stop
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
