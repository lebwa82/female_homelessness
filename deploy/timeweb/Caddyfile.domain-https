https://{$CHATWOOT_HOSTNAME} {
    tls /run/certs/chatwoot/fullchain.pem /run/certs/chatwoot/privkey.pem
    encode zstd gzip
    header >Strict-Transport-Security "max-age=31536000"
    reverse_proxy chatwoot:3000
}

http://:80 {
    @chatwoot host {$CHATWOOT_HOSTNAME}
    redir @chatwoot https://{$CHATWOOT_HOSTNAME}{uri} 308
    respond 404
}
