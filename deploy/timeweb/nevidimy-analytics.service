[Unit]
Description=Nevidimy internal analytics snapshot on Timeweb
Requisite=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/nevidimy-analytics.env
RuntimeDirectory=nevidimy-analytics
RuntimeDirectoryMode=0700
UMask=0077
TimeoutStartSec=10min
TimeoutStopSec=30s
ExecStartPre=/usr/bin/grep -Fxq timeweb-nevidimy-prod-app-msk-1 /etc/nevidimy-deployment-target
ExecStartPre=/bin/sh -ec 'digest=$${ANALYTICS_IMAGE#sha256:}; test "$$digest" != "$$ANALYTICS_IMAGE"; test "$${#digest}" -eq 64; case "$$digest" in *[!0-9a-f]*) exit 1;; esac'
ExecStart=/usr/bin/docker run --rm --pull=never --name=nevidimy-hourly-analytics \
    --cidfile=/run/nevidimy-analytics/container.cid --network=nevidimy-timeweb_default \
    --user=65534:65534 --cap-drop=ALL --security-opt=no-new-privileges=true --read-only \
    --cpus=1 --memory=768m --memory-swap=768m --pids-limit=64 \
    --tmpfs=/tmp:rw,noexec,nosuid,nodev,size=512m,mode=1777 \
    --mount=type=bind,src=/opt/nevidimy/analytics/current,dst=/analytics-source,readonly \
    --mount=type=bind,src=/opt/nevidimy/analytics/xlsxwriter,dst=/analytics-deps,readonly \
    --mount=type=bind,src=/opt/nevidimy/certs/postgresql-ca.crt,dst=/run/certs/postgresql-ca.crt,readonly \
    --workdir=/analytics-source --env=PYTHONPATH=/analytics-source:/analytics-deps \
    --env=PYTHONDONTWRITEBYTECODE=1 --env=TMPDIR=/tmp \
    --env=ANALYTICS_ACCOUNT_ID --env=ANALYTICS_INBOX_ID --env=ANALYTICS_BOT_NAME \
    --env=ANALYTICS_EXCLUDED_DISPLAY_IDS --env=ANALYTICS_PG_HOST --env=ANALYTICS_PG_PORT \
    --env=ANALYTICS_PG_DATABASE --env=ANALYTICS_PG_USER --env=ANALYTICS_PG_PASSWORD \
    --env=ANALYTICS_PG_CA=/run/certs/postgresql-ca.crt \
    --env=ANALYTICS_S3_BUCKET --env=ANALYTICS_S3_ACCESS_KEY --env=ANALYTICS_S3_SECRET_KEY \
    --env=ANALYTICS_TEAM_SHARE_ID --env=ANALYTICS_TEAM_SHARE_EXPIRES_AT \
    --entrypoint=/app/.venv/bin/python -- ${ANALYTICS_IMAGE} -m analytics.hourly_export
# On a timeout, remove only the container created by this invocation.
ExecStopPost=-/bin/sh -c 'if test -s /run/nevidimy-analytics/container.cid; then /usr/bin/xargs -r -a /run/nevidimy-analytics/container.cid /usr/bin/docker rm -f -- >/dev/null; fi'
