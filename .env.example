# Telegram Bot API transport. Leave empty for a direct connection.
# Supported: http://user:password@host:port, https://..., socks5://..., or
# tg://socks?server=host&port=1080&user=login&pass=password
# Do not use tg://proxy?server=...&secret=...: it is an MTProto client proxy,
# not a proxy for Telegram Bot API.
TELEGRAM_PROXY_URL=

# Runtime mode: development (local), production (VM), or test.
# `ENV` is accepted for compatibility, but use this more specific name.
APP_ENV=development
# A non-secret build identifier shown by the hidden /system_info command.
BUILD_VERSION=dev

# Required secrets; keep their real values only in .env or /etc/women-help-bot.env.
TELEGRAM_BOT_TOKEN=
YANDEX_AI_API_KEY=
